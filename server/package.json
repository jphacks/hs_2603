{
  "name": "kantan-ai-server",
  "version": "0.1.0",
  "private": true,
  "description": "e-editor の AI サーバー（アカウント・トークンの管理・Amazon Bedrock の中継・管理画面）",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/index.ts",
    "admin:create": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli/create-admin.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "fastify": "5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "5.9.3"
  }
}
