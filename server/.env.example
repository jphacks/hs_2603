# e-editor の AI サーバーの設定の見本
# このファイルをコピーして、同じ server フォルダーに .env という名前で置いてください（start.cmd を起動すると、無ければ自動で作ります）。
# start.cmd で動かしているときは、.env を保存すると、自動で読み直してサーバーを起動し直します。
# .env は .gitignore で除外しているので、git には入りません（パスワードやキーは絶対にコミットしないでください）。

# サーバーを待ち受けるアドレスとポート（0.0.0.0 なら、同じネットワークのほかの PC からもつながる）
HOST=0.0.0.0
PORT=8787

# PostgreSQL への接続（ユーザー名・パスワード・データベース名は、自分で作ったものに書き換える）
DATABASE_URL=postgres://e_editor:パスワード@localhost:5432/e_editor

# Amazon Bedrock の API キーとリージョン（AI はこのキーで動き、料金はキーの AWS アカウントにかかる）
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-northeast-1

# 使うモデル（書かなければ、東京・大阪では jp.anthropic.claude-sonnet-4-6）
# BEDROCK_MODEL=jp.anthropic.claude-sonnet-4-6

# AI アシスタントが画像を作るときのモデルとリージョン（同じ API キーで動く。Stability AI の画像モデルはオレゴン）
# 標準はいちばんきれいな Stable Image Ultra。速く安くしたいときは stability.stable-image-core-v1:1
# 画像 1 枚を、月のトークンの IMAGE_TOKENS トークン分として数える
# IMAGE_MODEL=stability.stable-image-ultra-v1:1
# IMAGE_REGION=us-west-2
# IMAGE_TOKENS=25000

# トークンの上限を区切る月のタイムゾーン
TIMEZONE=Asia/Tokyo

# Cloudflare Tunnel や Caddy などの裏で動かすときは、HOST=127.0.0.1・COOKIE_SECURE=true・TRUST_PROXY=true にする
# HTTPS で待ち受けるとき（証明書と秘密鍵のファイル）。前に Caddy などを置くなら空のままで TRUST_PROXY=true
# TLS_CERT=
# TLS_KEY=
# HTTPS の裏で動かすとき true（管理画面のクッキーを HTTPS だけで送る）
# COOKIE_SECURE=false
# 前にリバースプロキシを置くとき true（接続元の IP を X-Forwarded-For から読む）
# TRUST_PROXY=false
